{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Table Tavern",
  "version": "0.3.0",
  "identifier": "com.tabletavern.app",
  "build": {
    "beforeDevCommand": "npm run build:mvu-bundle && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Table Tavern",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "style-src-attr": "'unsafe-inline'",
        "img-src": "'self' data: https: http:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost https://openrouter.ai",
        "frame-src": "tt-sandbox: http://tt-sandbox.localhost",
        "worker-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-",
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "macos/en.lproj/InfoPlist.strings",
        "Resources/zh-Hant.lproj/InfoPlist.strings": "macos/zh-Hant.lproj/InfoPlist.strings"
      }
    },
    "resources": {
      "src/data/scene/opencc/LICENSE.txt": "licenses/OpenCC/LICENSE.txt",
      "src/data/scene/opencc/NOTICE.txt": "licenses/OpenCC/NOTICE.txt",
      "../node_modules/opencc-js/LICENSE": "licenses/opencc-js/LICENSE",
      "../node_modules/opencc-js/LICENSES/Apache-2.0.txt": "licenses/opencc-js/Apache-2.0.txt",
      "../node_modules/opencc-js/THIRD_PARTY_LICENSES.md": "licenses/opencc-js/THIRD_PARTY_LICENSES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/TaoGongSun/Table-Tavern/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3Q0M3NjdDMUUxRUFEN0YKUldSL3JSNGVmSGJNUjRGZjJpQUtjUk00MzhWb3lPeGhvbVNDNDAzcnhxaXhFVGZsMWhtUm1FdEIK"
    }
  }
}
