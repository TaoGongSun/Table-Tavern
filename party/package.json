{
  "name": "table-tavern-party",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "dev": "vite",
    "dev:server": "wrangler dev --config server/workers/wrangler.toml",
    "build:node": "vite build --config vite.node.config.ts",
    "start:node": "node dist-node/server.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "~8.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "~5.20261008.1",
    "@types/node": "~22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "~8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^20.14.5",
    "typescript": "~5.8.3",
    "vite": "~7.3.7",
    "vitest": "4.1.11",
    "wrangler": "~4.149.0"
  }
}
