          "findRegex": "/^([\\s\\S]*?)<blackboard>\\s*([\\s\\S]*?)\\s*<\\/blackboard>([\\s\\S]*)$/i",
          "replaceString": "<!DOCTYPE html>\n<html lang=\"zh-Hant\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>\n.econ-classroom,.econ-classroom *{box-sizing:border-box}\n.econ-classroom{color-scheme:dark;width:min(940px,100%);height:calc(100vh - 24px);min-height:520px;margin:0 auto;display:grid;grid-template-rows:auto minmax(0,1fr) auto;gap:12px;font-family:ui-serif,\"Noto Serif TC\",\"PingFang TC\",\"Microsoft JhengHei\",serif;color:#eee8d8}\n.econ-classroom .board-frame{padding:9px;border-radius:16px;background:linear-gradient(135deg,#6b4b2d,#3d291a 48%,#795737);box-shadow:0 10px 28px #0008,inset 0 0 0 1px #b98b59}\n.econ-classroom .board{position:relative;max-height:34vh;overflow:auto;padding:20px 24px;border-radius:8px;border:1px solid #678276;background:radial-gradient(circle at 20% 10%,#285446 0,#1f493c 30%,#173c31 68%,#123229 100%);box-shadow:inset 0 0 24px #071b16aa}\n.econ-classroom .board:before{content:\"ECONOMICS\";display:block;margin-bottom:12px;font:600 11px/1.2 ui-sans-serif,system-ui,sans-serif;letter-spacing:.18em;color:#d9d0ac99}\n.econ-classroom .chalk{white-space:pre-wrap;overflow-wrap:anywhere;font-family:\"Chalkboard SE\",\"Bradley Hand\",\"PingFang TC\",\"Microsoft JhengHei\",sans-serif;font-size:clamp(18px,2.2vw,24px);line-height:1.58;letter-spacing:.015em;color:#f6f1dc;text-shadow:0 0 1px #fff,1px 1px 0 #071b1644}\n.econ-classroom .chalk::first-line{font-weight:700;color:#fffbea}\n.econ-classroom .lecture{min-height:0;overflow:auto;padding:18px 20px;border:1px solid #ffffff18;border-radius:14px;background:#111614e6;box-shadow:inset 0 1px 0 #ffffff0d}\n.econ-classroom .prose{white-space:pre-wrap;overflow-wrap:anywhere;font-size:16px;line-height:1.82;color:#ece7da}\n.econ-classroom .prose:empty{display:none}\n.econ-classroom .composer{display:none;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:end;padding:10px;border:1px solid #ffffff1a;border-radius:14px;background:#111614f2;box-shadow:0 -6px 20px #0004}\n.econ-classroom.tt .composer{display:grid}\n.econ-classroom .composer textarea{width:100%;min-height:46px;max-height:120px;resize:vertical;padding:11px 13px;border:1px solid #ffffff24;border-radius:10px;background:#080c0b;color:#f3eee2;font:15px/1.5 ui-sans-serif,system-ui,\"PingFang TC\",\"Microsoft JhengHei\",sans-serif;outline:none}\n.econ-classroom .composer textarea:focus{border-color:#a88a58;box-shadow:0 0 0 2px #a88a5828}\n.econ-classroom .composer button{height:46px;padding:0 17px;border:1px solid #c59b60;border-radius:10px;background:linear-gradient(#7b5a35,#5b4026);color:#fff8e9;font-weight:700;cursor:pointer}\n.econ-classroom .composer button:disabled{opacity:.55;cursor:default}\n@media(max-width:600px){.econ-classroom{height:calc(100vh - 14px);min-height:460px;gap:8px}.econ-classroom .board-frame{padding:6px;border-radius:12px}.econ-classroom .board{padding:16px 15px;max-height:31vh}.econ-classroom .lecture{padding:14px}.econ-classroom .prose{font-size:15px}.econ-classroom .composer{grid-template-columns:1fr auto;padding:8px;gap:7px}.econ-classroom .composer button{padding:0 13px}}\n</style>\n</head>\n<body style=\"margin:0;padding:12px;background:transparent;overflow:hidden\">\n<main class=\"econ-classroom\" id=\"econ-classroom\">\n  <div class=\"board-frame\"><section class=\"board\"><div class=\"chalk\">$2</div></section></div>\n  <section class=\"lecture\"><div class=\"prose\">$1$3</div></section>\n  <form class=\"composer\" id=\"composer\">\n    <textarea id=\"lesson-input\" rows=\"1\" placeholder=\"繼續問林教授……\"></textarea>\n    <button id=\"send-button\" type=\"submit\">送出</button>\n  </form>\n</main>\n<script>\n(function(){\n  var app=document.getElementById(\"econ-classroom\");\n  var form=document.getElementById(\"composer\");\n  var input=document.getElementById(\"lesson-input\");\n  var button=document.getElementById(\"send-button\");\n  var isTableTavern=!!window.__ttHost && typeof window.triggerSlash===\"function\";\n  if(!isTableTavern)return;\n  app.classList.add(\"tt\");\n\n  function send(){\n    var text=input.value.trim();\n    if(!text||button.disabled)return;\n    button.disabled=true;\n    button.textContent=\"送出中…\";\n    input.value=\"\";\n    window.triggerSlash(\"/send \"+text+\"|/trigger\");\n    window.setTimeout(function(){\n      button.disabled=false;\n      button.textContent=\"送出\";\n      input.focus();\n    },1800);\n  }\n\n  form.addEventListener(\"submit\",function(event){\n    event.preventDefault();\n    send();\n  });\n  input.addEventListener(\"keydown\",function(event){\n    if(event.key===\"Enter\"&&!event.shiftKey&&!event.isComposing){\n      event.preventDefault();\n      send();\n    }\n  });\n  input.focus();\n})();\n</script>\n</body>\n</html>",
