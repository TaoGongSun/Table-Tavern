{
  "_comment": "mvu-replace-numeric：沒重構的 MVU 卡 JSONPatch replace 的後端（mechanism Upstream 策略＋卡片變數模式合回 stat_data）與前端墊片 Mvu.parseMessage 必須得到完全相同的 stat_data。語意照上游 MagVarUpdate 438f9ffc update_variables.ts L906-956；set 產生的非有限數在整批做完、序列化時轉 null〔作者裁決 2026-10-04〕。 backend_rejected：後端記帳預期拒收的路徑（墊片沒有記帳），結果兩邊仍須完全一致。",
  "cases": [
    {
      "name": "數字換數字",
      "stat_data": {
        "金": 100000
      },
      "patch": [
        {
          "op": "replace",
          "path": "/金",
          "value": 99000
        }
      ],
      "expected": {
        "金": 99000
      }
    },
    {
      "name": "數字字串轉數字",
      "stat_data": {
        "金": 10
      },
      "patch": [
        {
          "op": "replace",
          "path": "/金",
          "value": "85"
        }
      ],
      "expected": {
        "金": 85
      }
    },
    {
      "name": "前後空白的數字字串",
      "stat_data": {
        "金": 10
      },
      "patch": [
        {
          "op": "replace",
          "path": "/金",
          "value": " 12.5 "
        }
      ],
      "expected": {
        "金": 12.5
      }
    },
    {
      "name": "轉不成數字變 null",
      "stat_data": {
        "金": 10
      },
      "patch": [
        {
          "op": "replace",
          "path": "/金",
          "value": "很多"
        }
      ],
      "expected": {
        "金": null
      }
    },
    {
      "name": "設成 null",
      "stat_data": {
        "角色": {
          "好感": 50
        }
      },
      "patch": [
        {
          "op": "replace",
          "path": "/角色/好感",
          "value": null
        }
      ],
      "expected": {
        "角色": {
          "好感": null
        }
      }
    },
    {
      "name": "巢狀數字不夾範圍",
      "stat_data": {
        "角色": {
          "好感": 10,
          "名": "阿明"
        }
      },
      "patch": [
        {
          "op": "replace",
          "path": "/角色/好感",
          "value": 250
        }
      ],
      "expected": {
        "角色": {
          "好感": 250,
          "名": "阿明"
        }
      }
    },
    {
      "name": "現值/上限整值改寫",
      "stat_data": {
        "HP": "480/500"
      },
      "patch": [
        {
          "op": "replace",
          "path": "/HP",
          "value": "450/600"
        }
      ],
      "expected": {
        "HP": "450/600"
      }
    },
    {
      "name": "值帶說明只改第 0 項",
      "stat_data": {
        "好感": [
          50,
          "對主角的好感"
        ]
      },
      "patch": [
        {
          "op": "replace",
          "path": "/好感",
          "value": 85
        }
      ],
      "expected": {
        "好感": [
          85,
          "對主角的好感"
        ]
      }
    },
    {
      "name": "同一欄先 replace 再 delta",
      "stat_data": {
        "金": 10
      },
      "patch": [
        {
          "op": "replace",
          "path": "/金",
          "value": 20
        },
        {
          "op": "delta",
          "path": "/金",
          "value": 5
        }
      ],
      "expected": {
        "金": 25
      }
    },
    {
      "name": "bom-number",
      "stat_data": {
        "金": 10
      },
      "patch": [
        {
          "op": "replace",
          "path": "/金",
          "value": "\uFEFF85"
        }
      ],
      "expected": {
        "金": 85
      }
    },
    {
      "name": "wide-hex",
      "stat_data": {
        "金": 10
      },
      "patch": [
        {
          "op": "replace",
          "path": "/金",
          "value": "0x10000000000000000"
        }
      ],
      "expected": {
        "金": 18446744073709551616
      }
    },
    {
      "name": "vwd-bool",
      "stat_data": {
        "金": [
