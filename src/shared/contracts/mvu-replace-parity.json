        "P": {
          "a": 1
        }
      },
      "patch": [
        {
          "op": "replace",
          "path": "/P/a",
          "value": 85
        },
        {
          "op": "replace",
          "path": "/P",
          "value": {
            "a": "85"
          }
        }
      ],
      "expected": {
        "P": {
          "a": "85"
        }
      }
    },
    {
      "name": "字串子欄 set 數字字串後 delta 兄弟欄，子欄仍是字串",
      "stat_data": {
        "P": {
          "a": "s",
          "b": 2
        }
      },
      "patch": [
        {
          "op": "replace",
          "path": "/P/a",
          "value": "123"
        },
        {
          "op": "delta",
          "path": "/P/b",
          "value": 3
        }
