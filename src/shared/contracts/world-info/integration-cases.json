    }
   ],
   "entries": [
    {
     "id": "1",
     "raw": {
      "comment": "條目1",
      "constant": true,
      "order": 200,
      "content": "{{setvar::門::開著}}門已{{getvar::門}}"
     }
    },
    {
     "id": "2",
     "raw": {
      "comment": "條目2",
      "key": [
       "龍"
      ],
