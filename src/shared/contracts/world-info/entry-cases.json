  {
   "name": "book order: array without ids uses the index",
   "form": "bookOrder",
   "entries": "[{},{},{}]",
   "expected": [
    "0",
    "1",
    "2"
   ]
  },
  {
   "name": "book order: duplicate id keeps the position of the first, the value of the last",
   "form": "bookOrder",
   "entries": "[{\"id\":5},{\"id\":2},{\"id\":5,\"n\":1},{\"id\":1}]",
   "expected": [
    "3",
    "1",
    "2"
   ]
  },
  {
   "name": "book order: missing id collides with another entry's id",
   "form": "bookOrder",
   "entries": "[{\"id\":1},{},{\"id\":0}]",
   "expected": [
    "2",
    "1"
   ]
  },
  {
   "name": "book order: string, null and float ids",
   "form": "bookOrder",
   "entries": "[{\"id\":\"b\"},{\"id\":\"a\"},{\"id\":\"10\"},{\"id\":\"2\"},{\"id\":null},{\"id\":1.5},{\"id\":\"01\"}]",
   "expected": [
    "3",
    "2",
    "0",
    "1",
    "4",
    "5",
    "6"
   ]
  },
  {
   "name": "book order: non-object items are skipped but keep their index",
   "form": "bookOrder",
   "entries": "[{\"id\":4},\"x\",null,{\"id\":3}]",
   "expected": [
    "3",
    "0"
   ]
  },
