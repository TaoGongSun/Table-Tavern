          {
            "scriptName": "星港介面",
            "findRegex": "<HarborUI/>",
            "replaceString": "```html\n<!DOCTYPE html>\n<html><head><style>body{font:14px sans-serif}</style></head><body>\n<p id=\"info\">載入中</p>\n<p id=\"visits\"></p>\n<p id=\"ships\"></p>\n<p id=\"saved\"></p>\n<button id=\"go\">介面送出</button>\n<button id=\"add\">加一艘船</button>\n<script>\n$(errorCatched(async function () {\n  var last = getChatMessages(-1)[0];\n  document.getElementById('info').textContent = '樓 ' + getCurrentMessageId() + '／最後 ' + getLastMessageId() + '：' + last.message.slice(0, 5);\n  var visits = Number(localStorage.getItem('visits') || '0') + 1;\n  localStorage.setItem('visits', String(visits));\n  document.getElementById('visits').textContent = '來過 ' + visits + ' 次';\n  document.getElementById('go').onclick = function () { triggerSlash('/send 從介面送出'); };\n  await waitGlobalInitialized('Mvu');\n  var id = getCurrentMessageId();\n  function draw() {\n    var data = Mvu.getMvuData({ type: 'message', message_id: id });\n    document.getElementById('ships').textContent = '船隻 ' + _.get(data, 'stat_data.港口.船隻');\n  }\n  draw();\n  eventOn(Mvu.events.VARIABLE_UPDATE_ENDED, draw);\n  document.getElementById('add').onclick = function () {\n    var data = Mvu.getMvuData({ type: 'message', message_id: id });\n    data.stat_data.港口.船隻 += 1;\n    Mvu.replaceMvuData(data, { type: 'message', message_id: id }).then(function () {\n      document.getElementById('saved').textContent = '已寫入';\n      draw();\n    });\n  };\n}));\n</script>\n</body></html>\n```",
            "trimStrings": [],
            "placement": [
              2
            ],
